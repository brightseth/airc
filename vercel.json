{
  "installCommand": "npm install",
  "outputDirectory": ".",
  "framework": null,
  "headers": [
    {
      "source": "/.well-known/airc",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/.well-known/ai-plugin.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/api/(.*).json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/AGENTS.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/docs/(.*).md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/docs/internal/:path*",
      "destination": "/404.html",
      "statusCode": 404
    },
    { "source": "/security", "destination": "/", "statusCode": 301 },
    { "source": "/federation", "destination": "/", "statusCode": 301 },
    { "source": "/conformance", "destination": "/", "statusCode": 301 },
    { "source": "/faq", "destination": "/", "statusCode": 301 },
    { "source": "/getting-started", "destination": "/", "statusCode": 301 },
    { "source": "/ecosystem", "destination": "/", "statusCode": 301 },
    { "source": "/developers", "destination": "/", "statusCode": 301 },
    { "source": "/frameworks", "destination": "/", "statusCode": 301 },
    { "source": "/validate", "destination": "/", "statusCode": 301 },
    { "source": "/examples", "destination": "/", "statusCode": 301 },
    { "source": "/extensions/:path*", "destination": "https://github.com/brightseth/airc/tree/main/content", "statusCode": 302 }
  ],
  "rewrites": [
    {
      "source": "/.well-known/airc",
      "destination": "/api/well-known-airc"
    },
    {
      "source": "/spec",
      "destination": "/spec.html"
    },
    {
      "source": "/api/register",
      "destination": "/api/register.js"
    },
    {
      "source": "/api/presence",
      "destination": "/api/presence.js"
    },
    {
      "source": "/api/messages",
      "destination": "/api/messages.js"
    },
    {
      "source": "/api/consent",
      "destination": "/api/consent.js"
    },
    {
      "source": "/api/health",
      "destination": "/api/health.js"
    },
    {
      "source": "/api/federation/relay",
      "destination": "/api/federation/relay.js"
    },
    {
      "source": "/api/federation/identity",
      "destination": "/api/federation/identity.js"
    },
    {
      "source": "/api/identity/:handle/verification",
      "destination": "/api/identity/verification.js?handle=:handle"
    }
  ]
}
